{
  "DIFFICULTY_ENUM": ["easy", "medium", "hard"],

  "BASE_METADATA": {
    "type": "object",
    "required": ["grade_level", "subject", "topic", "difficulty"],
    "properties": {
      "grade_level": { "type": "string" },
      "subject": { "type": "string" },
      "topic": { "type": "string" },
      "difficulty": { "type": "string", "enum": "DIFFICULTY_ENUM" }
    },
    "additionalProperties": true
  },
  "MCQ_SCHEMA": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["question_type", "metadata", "questions"],
    "properties": {
      "question_type": { "type": "string", "const": "mcq" },
      "metadata": "BASE_METADATA",
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "topic",
            "question",
            "options",
            "answer",
            "solution"
          ],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "topic": { "type": "string" },
            "question": { "type": "string" },
            "options": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 6,
              "properties": {
                "A": { "type": "string" },
                "B": { "type": "string" },
                "C": { "type": "string" },
                "D": { "type": "string" }
              },
              "additionalProperties": false
            },
            "answer": { "type": "string" },
            "solution": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },

  "FILL_BLANKS_SCHEMA": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["question_type", "metadata", "questions"],
    "properties": {
      "question_type": { "type": "string", "const": "fill_in_the_blanks" },
      "metadata": "BASE_METADATA",
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "question", "answer", "solution"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "topic": { "type": "string" },

            "question": {
              "type": "string",
              "pattern": "_{2,}|\\{\\{blank\\}\\}"
            },
            "answer": { "type": "string" },

            "solution": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },

  "MATCH_FOLLOWING_SCHEMA": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["question_type", "metadata", "questions"],

    "properties": {
      "question_type": { "type": "string", "const": "match_the_following" },
      "metadata": "BASE_METADATA",
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "column_a", "column_b", "answer", "solution"],

          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "column_a": {
              "type": "array",
              "minItems": 2,

              "items": {
                "type": "object",
                "required": ["label", "text"],

                "properties": {
                  "label": { "type": "string" },
                  "text": { "type": "string" }
                },
                "additionalProperties": true
              }
            },

            "column_b": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["label", "text"],

                "properties": {
                  "label": { "type": "string" },
                  "text": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "answer": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": { "type": "string" }
              }
            },

            "solution": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },

  "SHORT_QA_SCHEMA": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["question_type", "metadata", "questions"],
    "properties": {
      "question_type": { "type": "string", "const": "short_question_answer" },
      "metadata": "BASE_METADATA",
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "question", "answer"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "question": { "type": "string" },
            "answer": { "type": "string" },
            "topic": { "type": "string" },
            "keywords": {
              "type": "array",
              "optional": true,
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },

  "LONG_QA_SCHEMA": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["question_type", "metadata", "questions"],
    "properties": {
      "question_type": { "type": "string", "const": "long_question_answer" },
      "metadata": "BASE_METADATA",
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "question", "answer"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "question": { "type": "string" },
            "answer": { "type": "string" },
            "topic": { "type": "string" },
            "sub_questions": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "object",
                "required": ["label", "question", "answer"],
                "properties": {
                  "label": { "type": "string" },
                  "question": { "type": "string" },
                  "answer": { "type": "string" }
                }
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  }
}
